# Copy this file to `.env.local` (gitignored by default) and adjust for
# your environment. See lib/env.ts for how these are consumed.

# Base URL of the Studio app (app/web + app/server) that the landing page's
# "Explore the model" CTA links to. Defaults to the local Studio dev server
# (`python -m app.server`, port 8000) if unset, so local `npm run dev` works
# without any setup. In staging/production, set this to the real deployed
# Studio URL, e.g. https://studio.example.com
NEXT_PUBLIC_STUDIO_URL=http://localhost:8000
