# Copy this file to `.env.local` (gitignored by default) and adjust for
# your environment. See lib/env.ts for how these are consumed.

# Base URL of the Studio app (app/web + app/server) that the landing page's
# "Explore the model" CTA links to.
#
# DO NOT IMPORT THIS FILE INTO A HOSTING DASHBOARD. The value below is correct
# for `npm run dev` and wrong for any deployment: `localhost` means "this
# computer" to whoever loads the page, so a public site built with it points
# its primary call to action at the VISITOR'S machine. A production build now
# REFUSES both an unset value and a loopback one (lib/env.ts) -- the second
# check exists specifically because importing this file would have satisfied
# the first.
#
# For a deployment, set the Studio's real public URL, e.g.
# https://studio.example.com -- and note it is inlined at BUILD time, so
# changing it later needs a redeploy, not just a settings change.
NEXT_PUBLIC_STUDIO_URL=http://localhost:8000
