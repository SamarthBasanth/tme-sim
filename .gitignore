# virtualenv
.venv/
# python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
# large downloaded open datasets (regenerate via `python -m tmesim.cli acquire`)
data_cache/
# per-regime experiment output dirs (keep the top-level result artifacts)
results/regime_pp*/
results/tl_pp*/
# tmesim Studio local run history + binary payloads (regenerated by re-running)
app/runs/
# tmesim Studio local projects/studies (ids into app/runs/, not results)
app/projects/
# tmesim Studio generated therapy reports (assembled from app/runs/, regenerable)
app/reports/
# tmesim Studio "bring your own compound" store. USER DATA: an operator's own
# SMILES and their own IC50s -- an unpublished compound series is exactly the
# thing that must not be committed. Only the inputs are ever written here (every
# compiled number is recomputed on read); see results/bring_your_own_compound.md.
app/compounds/

# Private build store for the static export (regenerate: scripts/studio_export/export_studio_runs.py)
results/export_runs/

# Runtime upload directory for TPL "drug ... from file" (contents are user data)
app/uploads/*
!app/uploads/.gitkeep

# Regenerable stage cache for the immune-sink sweep (delete to force recompute)
results/immune_sink_impact_cache.pkl

# Local browser-verification screenshots (not build output, not for the repo)
.export-drive/
